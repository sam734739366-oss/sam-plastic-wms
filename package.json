{
  "name": "sam-plastic",
  "version": "1.1.0",
  "description": "برنامج سام بلاستيك لإدارة مصنع نفخ العبوات البلاستيكية",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.samplastic.app",
    "productName": "سام بلاستيك",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "sam-plastic-setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sam734739366-oss",
      "repo": "sam-plastic-wms",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "electron-updater": "^6.8.11"
  }
}
